# File server for the exported web app, INSIDE the web container. Plain HTTP on :80 — TLS and
# the public hostname are the edge Caddy's job (PetBookerBackend/docker/Caddyfile), and this
# container is never published to the host.

:80 {
	root * /srv
	encode gzip zstd

	# The app uses real URLs (navigation/linking.ts maps ~44 routes: /search, /services/12,
	# /bookings/7, /messages/3, /admin/partners, ...). Those paths exist only in the client
	# router, so a refresh or a pasted link must return the shell and let the app route it.
	# Without this, every deep link is a 404 and the address bar becomes decorative.
	try_files {path} /index.html

	# Bundle and assets carry a content hash in the filename, so a changed file is a changed URL
	# and this can never serve stale code.
	@immutable path /_expo/* /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The shell must NOT be cached: it is the one file whose URL stays the same across deploys,
	# so a cached copy pins returning visitors to the previous bundle indefinitely.
	@shell path / /index.html
	header @shell Cache-Control "no-cache"

	# Content-Security-Policy (front-end review 2026-10-14, S6: the app sent none). Login tokens live
	# in localStorage on the web, so a policy that only runs our own bundle is the main guard against
	# injected script. What it allows, and why:
	#   - script: the bundle; Google's Maps JS when a key is set (blocked, the maps fall back to OSM).
	#   - style 'unsafe-inline': react-native-web writes its styles into <style> tags and attributes.
	#   - img: uploaded photos from the API, map tiles, flags, Google imagery (https:, data:, blob:).
	#   - connect: the API and its hubs ({$API_ORIGIN} and {$API_WS_ORIGIN}: Chrome does not treat an
	#     https:// source as covering wss://), Google Maps, the Nominatim geocoder, the OSRM router.
	#   - frame-ancestors 'none': nobody may frame the app (clickjacking).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://*.googleapis.com https://*.gstatic.com https://*.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' {$API_ORIGIN} data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' {$API_ORIGIN} {$API_WS_ORIGIN} https://*.googleapis.com https://*.google.com https://*.gstatic.com https://nominatim.openstreetmap.org https://router.project-osrm.org; worker-src 'self' blob:; frame-src https://*.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	file_server

	log {
		output stdout
		format console
	}
}

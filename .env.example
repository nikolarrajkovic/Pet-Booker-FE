# Use your machine LAN IP for physical device testing (not localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5161

# Android emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5160

# iOS simulator
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5160

# If HTTPS is required and certificate is trusted on device
# EXPO_PUBLIC_API_BASE_URL=https://192.168.1.10:5161

# Google Maps JavaScript API key for the WEB maps (restrict to your dev origin,
# e.g. http://localhost:8081/*, and to the Maps JavaScript API only).
# Without billing enabled the map shows the "For development purposes only" watermark.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=YOUR_GOOGLE_MAPS_WEB_KEY_HERE

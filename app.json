{
  "expo": {
    "name": "PetBooker",
    "slug": "petbooker",
    "scheme": "petbooker",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PetBooker to use your location to find nearby pet care providers."
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#00A85A"
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petbooker.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.petbooker.app"
    },
    "extra": {
      "eas": {
        "projectId": "261a6be9-cb78-4267-9471-4f2fd799d1af"
      }
    },
    "owner": "nikolarrajkovic",
    "updates": {
      "url": "https://u.expo.dev/261a6be9-cb78-4267-9471-4f2fd799d1af"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}

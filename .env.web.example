# Build inputs for the web deployment (docker-compose.web.yml).
#
#   cp .env.web.example .env.web
#   chmod 600 .env.web
#   # fill in ON THE SERVER, then: docker compose -f docker-compose.web.yml --env-file .env.web up -d --build
#
# Both values are INLINED INTO THE JAVASCRIPT BUNDLE at build time. They are not runtime config:
# changing one means rebuilding the image, and neither is secret from anyone who opens devtools.

# =============================================================================================
# BACKEND ORIGIN
# =============================================================================================
# Where the app sends every API call, WebSocket and image request. No trailing slash.
#
# This is the backend's PUBLIC_HOST, not the web app's own hostname — the two are deliberately
# different origins so the app's URLs (/admin/partners, /bookings/7) cannot collide with the
# API's (/admin/users, POST /bookings/7/confirm).
#
# Must be https: the browser refuses to call http:// from an https:// page, and the chat and
# live-location hubs need the wss:// upgrade.
EXPO_PUBLIC_API_BASE_URL=https://203.0.113.10.sslip.io

# =============================================================================================
# GOOGLE MAPS — OPTIONAL
# =============================================================================================
# Maps JavaScript API key for the four web map surfaces (search map, address picker, directions
# modal, live-session map). Leaving this blank is a supported configuration: those maps render
# blank and everything else works.
#
# This is the WEB key, separate from the Android/iOS ones in EAS. Two things to get right:
#
#   1. Add this deployment's origin to the key's HTTP referrer restrictions
#      (e.g. https://app.203.0.113.10.sslip.io/*), or Google blocks every tile at runtime with
#      a console error and no visible explanation. The dev key is restricted to localhost:8081
#      and will NOT work here.
#   2. Restrict the key to the Maps JavaScript API. It ships inside a public bundle, so the
#      referrer restriction is the only thing standing between it and someone else's bill.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=

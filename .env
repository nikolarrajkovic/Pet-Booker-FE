# Committed dev defaults — NO SECRETS IN THIS FILE (this repo is public).
# Real keys belong in .env.local, which is gitignored and overrides everything here.

# API base URL (dev). Use your machine LAN IP for physical-device testing.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5161

# Android emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5161

# Google Maps JavaScript API key for the WEB maps.
# Placeholder only — put your real referrer-restricted key in .env.local.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=YOUR_GOOGLE_MAPS_WEB_KEY_HERE

# Native Google Maps keys, read by app.config.ts for the Android/iOS builds. A different key
# from the web one: these are restricted by app package + signing certificate, not by referrer.
# Leave unset here (a blank value means "no key", and the map renders blank rather than
# rejecting a placeholder). Real values go in .env.local for local builds, and in EAS
# environment variables for cloud builds — see ANDROID_BUILD.md.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

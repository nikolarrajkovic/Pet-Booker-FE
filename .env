# Committed dev defaults — NO SECRETS IN THIS FILE (this repo is public).
# Real keys belong in .env.local, which is gitignored and overrides everything here.

# API base URL (dev). Use your machine LAN IP for physical-device testing.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5161

# Android emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5161

# Google Maps JavaScript API key for the WEB maps.
# Placeholder only — put your real referrer-restricted key in .env.local.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=YOUR_GOOGLE_MAPS_WEB_KEY_HERE
